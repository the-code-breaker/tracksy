{
  "expo": {
    "name": "Tracksy",
    "slug": "tracksy",
    "scheme": "tracksy",
    "version": "0.6.0",
    "icon": "./assets/branding/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.tracksy.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Attach receipts to shared expenses."
      }
    },
    "android": {
      "package": "app.tracksy.mobile",
      "versionCode": 8,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Tracksy",
      "description": "Split smarter. Settle together."
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-notifications",
      "expo-web-browser",
      "@sentry/react-native",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
