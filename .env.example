# Copy these PUBLIC values into apps/mobile/.env. Never put service keys there.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_AUTH_REDIRECT=tracksy://auth/callback
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=
# Admin server only (apps/admin/.env.local)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Edge-function secrets only; set using supabase secrets set
SUPABASE_SERVICE_ROLE_KEY=
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ALLOWED_PRODUCTS=tracksy_group_monthly,tracksy_group_yearly
OCR_PROVIDER_URL=
OCR_PROVIDER_KEY=
