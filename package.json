{
  "name": "tracksy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run start -w @tracksy/mobile",
    "web": "npm run web -w @tracksy/mobile",
    "admin": "npm run dev -w @tracksy/admin",
    "typecheck": "tsc -p tsconfig.packages.json --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "node scripts/live-integration.mjs",
    "preview": "node scripts/serve-web.mjs",
    "apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "check": "npm run typecheck && npm test",
    "db:start": "supabase start",
    "db:prepare": "node scripts/prepare-database.mjs",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/domain/src/database.generated.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.15.0",
    "fake-indexeddb": "^6.2.6",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
